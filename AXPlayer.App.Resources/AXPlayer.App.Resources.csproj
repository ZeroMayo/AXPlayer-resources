<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<Title>AX Player Resources</Title>
		<Product>AX Player Resources</Product>
    </PropertyGroup>
	<PropertyGroup Label="Nuget">
		<Title>AX Player Resources</Title>
		<PackageId>ZeroMayo.AXPlayer.App.Resources</PackageId>
		<Authors>ZeroMayo</Authors>
		<PackageLicenseUrl>https://github.com/ZeroMayo/AXPlayer-resources/blob/master/LICENCE.md</PackageLicenseUrl>
		<PackageProjectUrl>https://github.com/ZeroMayo/AXPlayer-resources</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ZeroMayo/AXPlayer-resources</RepositoryUrl>
		<PackageReleaseNotes>Automated release.</PackageReleaseNotes>
		<copyright>Copyright (c) 2026 ZeroMayo</copyright>
		<PackageTags>ax-player app resources</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fonts\**\*" />
    <EmbeddedResource Include="Samples\**\*" />
    <EmbeddedResource Include="Textures\**\*" />
    <EmbeddedResource Include="Shaders\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>